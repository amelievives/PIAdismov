<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingTop="18dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical">

        <ImageView
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:background="@drawable/bg_recorder_badge"
            android:importantForAccessibility="no"
            android:padding="10dp"
            android:src="@drawable/ic_mic"
            app:tint="@color/recorder_accent" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:accessibilityHeading="true"
            android:fontFamily="@font/montserrat_extrabold"
            android:letterSpacing="-0.04"
            android:text="@string/recorder_title"
            android:textColor="@color/recorder_text"
            android:textSize="30sp" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:background="@drawable/bg_recorder_hero">

        <ImageView
            android:layout_width="146dp"
            android:layout_height="86dp"
            android:layout_gravity="top|end"
            android:layout_marginTop="12dp"
            android:layout_marginEnd="12dp"
            android:alpha="0.34"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_recorder_wave" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_recorder_status"
                android:gravity="center_vertical"
                android:paddingStart="10dp"
                android:paddingTop="6dp"
                android:paddingEnd="11dp"
                android:paddingBottom="6dp">

                <View
                    android:id="@+id/status_dot"
                    android:layout_width="8dp"
                    android:layout_height="8dp"
                    android:background="@drawable/bg_recorder_dot"
                    android:importantForAccessibility="no" />

                <TextView
                    android:id="@+id/tv_status"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="7dp"
                    android:accessibilityLiveRegion="polite"
                    android:fontFamily="sans-serif-medium"
                    android:text="@string/recorder_status_idle"
                    android:textColor="@color/recorder_hero_text"
                    android:textSize="12sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/tv_status_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="13dp"
                android:fontFamily="@font/montserrat_extrabold"
                android:letterSpacing="-0.03"
                android:text="@string/recorder_heading_idle"
                android:textColor="@color/recorder_hero_text"
                android:textSize="25sp" />

            <TextView
                android:id="@+id/tv_status_detail"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/recorder_detail_idle"
                android:textColor="@color/recorder_hero_muted"
                android:textSize="14sp" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btn_stop_rec"
                style="@style/Widget.PIAdismov.RecorderButton"
                android:layout_width="match_parent"
                android:layout_marginTop="18dp"
                android:background="@drawable/bg_recorder_primary"
                android:text="@string/recorder_stop"
                android:textColor="@color/recorder_on_primary"
                android:visibility="gone" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btn_toggle"
                style="@style/Widget.PIAdismov.RecorderButton"
                android:layout_width="match_parent"
                android:layout_marginTop="18dp"
                android:background="@drawable/bg_recorder_primary"
                android:text="@string/recorder_enable"
                android:textColor="@color/recorder_on_primary" />
        </LinearLayout>
    </FrameLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:background="@drawable/bg_recorder_panel"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"
            android:labelFor="@id/et_keyword"
            android:text="@string/recorder_keyword"
            android:textColor="@color/recorder_text"
            android:textSize="16sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical">

            <androidx.appcompat.widget.AppCompatEditText
                android:id="@+id/et_keyword"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@drawable/bg_recorder_input"
                android:hint="@string/recorder_keyword_hint"
                android:imeOptions="actionDone"
                android:inputType="text|textNoSuggestions"
                android:minHeight="50dp"
                android:paddingStart="14dp"
                android:paddingTop="9dp"
                android:paddingEnd="14dp"
                android:paddingBottom="9dp"
                android:singleLine="true"
                android:textColor="@color/recorder_text"
                android:textColorHint="@color/recorder_muted"
                android:textSize="17sp" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btn_save_word"
                style="@style/Widget.PIAdismov.RecorderButton"
                android:layout_width="wrap_content"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_recorder_save"
                android:text="@string/recorder_save"
                android:textColor="@color/recorder_accent"
                android:textSize="14sp" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/recorder_keyword_help"
            android:textColor="@color/recorder_muted"
            android:textSize="13sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="23dp"
        android:layout_marginBottom="10dp"
        android:gravity="center_vertical">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:accessibilityHeading="true"
            android:fontFamily="@font/montserrat_extrabold"
            android:letterSpacing="-0.025"
            android:text="@string/recorder_history"
            android:textColor="@color/recorder_text"
            android:textSize="20sp" />

        <TextView
            android:id="@+id/tv_recordings_count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_recorder_badge"
            android:fontFamily="sans-serif-medium"
            android:paddingStart="10dp"
            android:paddingTop="4dp"
            android:paddingEnd="10dp"
            android:paddingBottom="4dp"
            android:textColor="@color/recorder_accent"
            android:textSize="12sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/empty_recordings"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_recorder_panel"
        android:gravity="center_vertical"
        android:padding="14dp">

        <ImageView
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:background="@drawable/bg_recorder_badge"
            android:importantForAccessibility="no"
            android:padding="9dp"
            android:src="@drawable/ic_recorder_wave"
            app:tint="@color/recorder_accent" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:text="@string/recorder_empty"
            android:textColor="@color/recorder_muted"
            android:textSize="14sp" />
    </LinearLayout>
</LinearLayout>
